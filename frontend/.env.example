# Musify Frontend Environment Configuration

# Backend API URL (default for local development)
VITE_API_URL=http://localhost:3001/api

# Stream URL (defaults to same-origin /api in production, or http://localhost:3001/api for local development)
VITE_STREAM_URL=http://localhost:3001/api

# Optional: Direct stream bypass (opt-in only, off by default)
# When set to true, audio requests go directly to VITE_DIRECT_STREAM_URL instead of same-origin STREAM_BASE
# VITE_DIRECT_STREAM=false
# VITE_DIRECT_STREAM_URL=https://musify-backend-50047147406.development.catalystappsail.in/api
