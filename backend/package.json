{
  "name": "musify-backend",
  "version": "1.0.0",
  "description": "Musify Backend - YouTube Music InnerTube & Streaming Proxy API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "download-ytdlp": "node scripts/download-ytdlp.js",
    "prebuild": "node scripts/download-ytdlp.js",
    "build": "tsc",
    "prestart": "node scripts/download-ytdlp.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test tests/security.test.ts tests/reliability.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
